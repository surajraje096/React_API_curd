# Application Settings
APP_NAME="AI Agent Platform"
DEBUG=True
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL default, falls back to SQLite if PG unavailable)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db"
# Fallback local SQLite file path if Postgres is not running locally
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./agent.db"

# LLM Provider Configuration
OPENAI_API_KEY="your-openai-api-key-here"
DEFAULT_MODEL="gpt-4o-mini"
ENABLE_MOCK_LLM_IF_NO_KEY=True
